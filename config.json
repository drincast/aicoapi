{
  "default_provider": "mammouth",
  "timeout_seconds": 300,
  "max_tokens": 4096,
  "system_prompt": "Eres un asistente util. Responde de forma clara y concisa en el idioma en que te escriban.",
  "providers": {
    "openai": {
      "type": "openai",
      "model": "gpt-5",
      "url": "https://api.openai.com/v1/chat/completions",
      "api_key_env": "OPENAI_API_KEY"
    },
    "claude": {
      "type": "anthropic",
      "model": "claude-opus-5",
      "url": "https://api.anthropic.com/v1/messages",
      "api_key_env": "ANTHROPIC_API_KEY",
      "api_version": "2023-06-01"
    },
    "gemini": {
      "type": "gemini",
      "model": "gemini-3.5-flash",
      "url": "https://generativelanguage.googleapis.com/v1beta",
      "api_key_env": "GEMINI_API_KEY"
    },
    "mammouth": {
      "type": "openai",
      "model": "glm-5.2",
      "url": "https://api.mammouth.ai/v1/chat/completions",
      "api_key_env": "MAMMOUTH_API_KEY",
      "max_tokens_field": "max_tokens"
    }
  }
}
